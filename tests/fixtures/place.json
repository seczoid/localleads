ull,null,null,null,null,["0","-3266348857608127193"],null,null,[null,1],null,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT2xWdVJYcFBhVmRtTjBWd00wazJibXBxUmpoM1ExRRAB"]],"CIABIhCcZ9hOgMBRDaXaj0woz4hL",1]],null,null,null,[[["LOCAL_SERVICES_PRICE_QUALITY"],"How would you describe the price you paid?",[[[["E:LOCAL_SERVICES_PRICE_QUALITY_REASONABLE_PRICE"],"Reasonable price",2,null,null,"2ahUKEwi-v6jLx4yYAxWBBbkGHSw3OKQQ3YcHKAB6BAgBEFQ"]],1],null,null,"Price assessment",null,"2ahUKEwi-v6jLx4yYAxWBBbkGHSw3OKQQ3IcHKAZ6BAgBEFM",null,null,null,null,null,1,[[1]],2],[["LOCAL_SERVICES_JOB_TYPES"],"Which services did you get?",null,[[[["job_type_id:patio_design"],"Patio design",2,null,null,"2ahUKEwi-v6jLx4yYAxWBBbkGHSw3OKQQ3YcHKAB6BAgBEFY"],[["job_type_id:retaining_wall_design"],"Retaining wall design",2,null,null,"2ahUKEwi-v6jLx4yYAxWBBbkGHSw3OKQQ3YcHKAF6BAgBEFc"]],[1]],null,"Services",null,"2ahUKEwi-v6jLx4yYAxWBBbkGHSw3OKQQ3IcHKAd6BAgBEFU",null,null,null,null,null,3,[[1]],2]],null,null,null,null,null,null,null,["en"],[["I am relieved to say that not laying a patio down ourselves was one of the best decisions we have made.\nWow. I mean, wow. The yard under the balcony was a sloped, muddy and eroded mess.  Outdoor Spaces went, as one of the best idioms go to describe a service, “above and beyond” our expectation. It was a pleasure to meet everyone and Trey had no problem answering my worried questions.  I appreciated that they laid a barrier down on my already questionable grass so as to not damage it.  Care was taken around my existing garden bed and they even laid grass seed down when they were finished.\n\nMy animals are thrilled. We, and August, say thank you. It’s amazing.",null,[0,179]]]],[null,1781798508000000,1781798508000000,"4 months ago",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfMGxRQXM0R1RhNmQxeW9HUzZDTkRWdw%7CCAEQrcz1_gkiMAoZQ0hfMGxRQXM0R1RhNmQxeW9HUzZDTkRWdxoTQ2d3STdLelEwUVlRdzduMWl3TQ\u0026d\u003d286732320\u0026t\u003d7\u0026wv\u003d1",null,null,"2ahUKEwi-v6jLx4yYAxWBBbkGHSw3OKQQ_2MoCHoECAEQWA"],"https://business.google.com/local/business/13883070578812691709/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXZFZKWWNGQmhWbVJ0VGpCV2QwMHdhekppYlhCeFVtcG9NMUV4UlJBQhAA",[null,null,null,"/local/business/13883070578812691709/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXZFZKWWNGQmhWbVJ0VGpCV2QwMHdhekppYlhCeFVtcG9NMUV4UlJBQhAA"],"https://business.google.com/local/business/13883070578812691709/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXZFZKWWNGQmhWbVJ0VGpCV2QwMHdhekppYlhCeFVtcG9NMUV4UlJBQhAA",[null,null,null,"/local/business/13883070578812691709/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXZFZKWWNGQmhWbVJ0VGpCV2QwMHdhekppYlhCeFVtcG9NMUV4UlJBQhAA"],null,"https://business.google.com/local/business/13883070578812691709/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXZFZKWWNGQmhWbVJ0VGpCV2QwMHdhekppYlhCeFVtcG9NMUV4UlJBQhAA",[null,null,null,"/local/business/13883070578812691709/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhXZFZKWWNGQmhWbVJ0VGpCV2QwMHdhekppYlhCeFVtcG9NMUV4UlJBQhAA"],null,["en"],[["Thank you so much for your thoughtful review of Outdoor Spaces. We’re glad the patio installation transformed your yard into a space that feels functional, clean, and enjoyable. It’s great to hear our team’s care around your existing lawn and garden beds, along with the final details, made a difference.\n\nWe also love hearing that you and your animals are enjoying the space. Thank you again for trusting Outdoor Spaces with your project.",null,[0,238]]]],[null,null,174,["https://www.google.com/maps/reviews/data\u003d!4m8!14m7!1m6!2m5!1sCi9DQUlRQUNvZENodHljRjlvT2xWdVJYcFBhVmRtTjBWd00wazJibXBxUmpoM1ExRRAB!2m1!1s0x0:0xd2ab990515c3bd27!3m1!1s2@1:CAIQACodChtycF9oOlVuRXpPaVdmN0VwM0k2bmpqRjh3Q1E%7C%7C?hl\u003den-US"],["https://