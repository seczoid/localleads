l,null,null,null,null,null,null,null,null,null,["Ci9DQUlRQUNvZENodHljRjlvT21oRGVTMVBTMnA2VEMwNVdWSlBkRGcxZWxOclMxRRAB"]],"CIABIhB-BKXmHUffZFquYlv6emc8",1]],null,null,null,null,null,null,null,null,null,null,null,["en"],[["The team at Outdoor Spaces did a very good job on our project. We had them demo a portion of our wooden deck and replace that area with pavers. The work included some drainage updates, and Dave was able to help design an elegant solution.\n\nThe work was done quickly, each day the crew did a great job of cleaning up the job site and leaving things tidy, and either the crew or Trey answered any questions we had quickly.\n\nThey are thoughtful and their experience is evident in the way that they make decisions on all levels (scoping, project management, and work crew).",null,[0,238]]]],[null,1774902839000000,1774902839000000,"7 months ago",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfX054MllXbkdWZVJ1c0dTZzdmMGQ0QQ%7CCAEQrcz1_gkiMAoZQ0hfX054MllXbkdWZVJ1c0dTZzdmMGQ0QRoTQ2d3SXQ3eXJ6Z1lRdW9PaHV3TQ\u0026d\u003d286732320\u0026t\u003d7\u0026wv\u003d1",null,null,"2ahUKEwi-v6jLx4yYAxWBBbkGHSw3OKQQ_2MoBHoECAEQYg"],"https://business.google.com/local/business/13883070578812691709/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvUkdWVE1WQlRNbkEyVkVNd05WZFdTbEJrUkdjeFpXeE9jbE14UlJBQhAA",[null,null,null,"/local/business/13883070578812691709/customers/reviews/reply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvUkdWVE1WQlRNbkEyVkVNd05WZFdTbEJrUkdjeFpXeE9jbE14UlJBQhAA"],"https://business.google.com/local/business/13883070578812691709/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvUkdWVE1WQlRNbkEyVkVNd05WZFdTbEJrUkdjeFpXeE9jbE14UlJBQhAA",[null,null,null,"/local/business/13883070578812691709/customers/reviews/deletereply?p\u003dCkRDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMjFvUkdWVE1WQlRNbkEyVkVNd05WZFdTbEJrUkdjeFpXeE9jbE14UlJBQhAA"],null,"https://business.google.com/local/business/13883