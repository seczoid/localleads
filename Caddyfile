# Caddy serves LocalLeads over HTTPS at $DOMAIN, with certificates from
# Let's Encrypt (or its own local CA for "localhost"). Port 80 only
# redirects to HTTPS.

{
	# HTTP/3 (QUIC, over UDP) is off: with Linux's default UDP buffers it
	# slows big downloads such as exports to a few hundred KB/s on a
	# distant server, where HTTP/2 over TCP runs at the line's speed.
	servers {
		protocols h1 h2
	}
	# To get expiry notices from Let's Encrypt:
	# email you@example.com
}

{$DOMAIN} {
	# Live updates (/events) and MCP (/mcp) stream; don't compress them.
	@compress not path /events /mcp
	encode @compress zstd gzip

	reverse_proxy localleads:7878

	# The app sends HSTS and its other security headers itself.
	header -Server

	log {
		output stdout
		format console
	}
}
