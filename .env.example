# Copy to .env and edit. Used by compose.yaml.

# The domain people open. Point its DNS (A/AAAA record) at this server
# before starting, so Caddy can get a certificate. Use "localhost" to try it
# on your own machine (Caddy then uses its own local certificate authority).
DOMAIN=leads.example.com

# Optional: other ports, if 80/443 are taken. With a non-standard HTTPS port,
# also set PUBLIC_URL so links and the MCP endpoint include it.
# HTTP_PORT=80
# HTTPS_PORT=443
# PUBLIC_URL=https://leads.example.com:8443

# Optional: a fixed setup code for creating the account, instead of the
# random one printed in `docker compose logs localleads`.
# LOCALLEADS_SETUP_CODE=

# Optional: run a prebuilt image instead of building from source.
# LOCALLEADS_IMAGE=ghcr.io/seczoid/localleads:latest
